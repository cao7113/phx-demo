#!/bin/sh
set -eu

# ==============================================================================
# 脚本名称: eval
# 功能描述: 动态执行 Elixir 代码，支持从命令行参数或标准输入（stdin/管道）读取代码。
#
# 使用方法:
#   1. 命令行传参执行 (无需最外层双引号):
#      ./eval <elixir-code>
#      示例: ./eval IO.puts "hi"
#
#   2. 管道 (stdin) 执行:
#      echo '<elixir-code>' | ./eval
#      示例: echo 'IO.puts "hello world"' | ./eval
#
#   3. Here Doc / 文件重定向 (stdin) 执行:
#      ./eval << 'EOF'
#      IO.puts "hi from heredoc"
#      EOF
# ==============================================================================

# 切换到脚本所在目录，确保相对路径以脚本当前目录为基准
cd -P -- "$(dirname -- "$0")"

# ------------------------------------------------------------------------------
# 代码获取逻辑:
# 1. 如果命令行有传参 ($# -gt 0)，将所有参数拼接为完整的 Elixir 表达式；
# 2. 如果无命令行参数且 stdin 不是终端 (! -t 0)，从 stdin/管道/Here Doc 读取代码；
# 3. 若均未提供，打印标准 Here Doc 帮助文档并退出。
# ------------------------------------------------------------------------------
if [ $# -gt 0 ]; then
	EVAL_EXPR="$*"
elif [ ! -t 0 ]; then
	EVAL_EXPR=$(cat)
else
	cat <<'USAGE' >&2
错误: 未提供任何 Elixir 代码。

用法说明:
  1) 命令行直接传入代码 (无需最外层引号):
     ./eval IO.puts "hi"
     ./eval MyApp.Repo.query! "SELECT 1"

  2) 通过管道传入代码:
     echo 'IO.puts "hi"' | ./eval

  3) 通过 Here Doc 传入多行代码:
     ./eval << 'EOF'
     users = MyApp.Repo.all(MyApp.User)
     Enum.each(users, fn user ->
       IO.inspect(user.email)
     end)
     EOF

  4) 通过文件重定向传入代码:
     ./eval < script.exs
USAGE
	exit 1
fi

# ------------------------------------------------------------------------------
# 执行应用 eval 命令
# ------------------------------------------------------------------------------
exec ./my_app eval "$EVAL_EXPR"
